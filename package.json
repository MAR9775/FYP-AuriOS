{
  "name": "aurios",
  "version": "1.1.0",
  "description": "AuriOS — Windows Desktop AI Assistant",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64"
  },
  "keywords": [
    "electron",
    "ai",
    "desktop",
    "assistant"
  ],
  "author": "AuriOS",
  "license": "MIT",
  "devDependencies": {
    "electron": "^41.1.1",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.aurios.app",
    "productName": "AuriOS",
    "copyright": "Copyright 2025 The Automators",
    "win": {
      "target": "nsis",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AuriOS",
      "deleteAppDataOnUninstall": false
    },
    "files": [
      "electron/**/*",
      "assets/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend/",
        "to": "backend/",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc"
        ]
      }
    ],
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    }
  }
}
